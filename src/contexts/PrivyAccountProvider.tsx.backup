import {
  useCreateWallet,
  useLogin,
  usePrivy,
  useSignAuthorization,
  useWallets,
} from "@privy-io/react-auth";
import { useMutation, useQuery } from "@tanstack/react-query";
import {
  create7702KernelAccount,
  create7702KernelAccountClient,
  signerToEcdsaValidator,
} from "@zerodev/ecdsa-validator";
import { createZeroDevPaymasterClient } from "@zerodev/sdk";
import { getUserOperationGasPrice } from "@zerodev/sdk/actions";
import React, { useEffect, useMemo } from "react";
import {
  createPublicClient,
  createWalletClient,
  custom,
  Hex,
  http,
} from "viem";
import { useAccount } from "wagmi";
import { AccountProviderContext, EmbeddedWallet } from "./AccountContext";
import {
  KERNEL_V3_3,
  getEntryPoint,
  KernelVersionToAddressesMap,
} from "@zerodev/sdk/constants";

/**
 * Constants for the Privy account provider
 */

const PROVIDER = "privy";
export const PROJECT_ID = process.env.NEXT_PUBLIC_ZERODEV_PROJECT_ID;
export const kernelVersion = KERNEL_V3_3;
export const kernelAddresses = KernelVersionToAddressesMap[kernelVersion];
export const entryPoint = getEntryPoint("0.7");

// Add debug logging helper
const debugLog = (message: string, data?: any) => {
  if (process.env.NODE_ENV === 'development') {
    console.log(`🔍 DynaVest Auth: ${message}`, data || '');
  }
};

/**
 * PrivyAccountProvider is a React component that manages authentication and wallet functionality
 * using Privy's authentication system. It handles wallet creation, kernel account setup,
 * and provides authentication UI components.
 * @deprecated
 * @param {Object} props - Component props
 * @param {React.ReactNode} props.children - Child components to be wrapped
 * @returns {JSX.Element} The provider component with authentication functionality
 */
const PrivyAccountProvider = ({ children }: { children: React.ReactNode }) => {
  const { wallets } = useWallets();
  const { user } = usePrivy();
  const { createWallet } = useCreateWallet();
  const { signAuthorization } = useSignAuthorization();
  const { chainId, chain } = useAccount();

  const bundlerRpc = `https://rpc.zerodev.app/api/v3/${PROJECT_ID}/chain/${chainId}`;
  const paymasterRpc = `https://rpc.zerodev.app/api/v3/${PROJECT_ID}/chain/${chainId}`;

  const { login } = useLogin();

  // Add debug logging for key state changes
  useEffect(() => {
    debugLog('Auth state changed', {
      hasUser: !!user,
      walletsCount: wallets.length,
      chainId,
      chainName: chain?.name,
      projectId: PROJECT_ID?.slice(0, 8) + '...'
    });
  }, [user, wallets.length, chainId, chain?.name]);

  const privyEmbeddedWallet = useMemo(() => {
    return wallets.find((wallet) => wallet.walletClientType === PROVIDER);
  }, [wallets]);

  /**
   * Creates a wallet client using the embedded wallet's ethereum provider
   * The configured wallet client or null if not available
   */
  const { data: privyAccount } = useQuery({
    queryKey: [PROVIDER, "walletClient", privyEmbeddedWallet?.address, chainId],
    queryFn: async () => {
      if (!privyEmbeddedWallet) {
        debugLog('No embedded wallet found');
        return null;
      }
      debugLog('Creating wallet client', { address: privyEmbeddedWallet.address });
      
      try {
        const walletClient = createWalletClient({
          account: privyEmbeddedWallet.address as Hex,
          chain,
          transport: custom(await privyEmbeddedWallet.getEthereumProvider()),
        });
        debugLog('Wallet client created successfully');
        return walletClient;
      } catch (error) {
        console.error('❌ Failed to create wallet client:', error);
        throw error;
      }
    },
    enabled: !!privyEmbeddedWallet,
  });

  /**
   * Creates a public client for blockchain interactions
   * The configured public client or null if wallet client is not available
   */
  const publicClient = useMemo(() => {
    debugLog('Creating public client', { bundlerRpc });
    return createPublicClient({
      chain,
      transport: http(bundlerRpc),
    });
  }, [chain, bundlerRpc]);

  /**
   * Creates a paymaster client for handling gas payments
   * RESTORED: Now that chain config is fixed, paymaster should work
   */
  const paymasterClient = useMemo(() => {
    if (!publicClient) {
      debugLog('No public client for paymaster');
      return null;
    }
    debugLog('Creating paymaster client', { paymasterRpc });
    return createZeroDevPaymasterClient({
      chain,
      transport: http(paymasterRpc),
    });
  }, [publicClient, paymasterRpc, chain]);

  /**
   * Creates an ECDSA validator for the kernel account
   * RESTORED: Full paymaster functionality
   */
  const { data: kernelClients, error: kernelError } = useQuery({
    queryKey: [
      PROVIDER,
      "kernelClient",
      privyAccount?.account.address,
      paymasterClient?.name,
      publicClient?.name,
      chainId,
    ],
    queryFn: async () => {
      debugLog('Starting kernel client creation with paymaster');
      
      if (!privyAccount || !publicClient || !paymasterClient) {
        debugLog('Missing prerequisites for kernel client', {
          hasPrivyAccount: !!privyAccount,
          hasPublicClient: !!publicClient,
          hasPaymasterClient: !!paymasterClient
        });
        return null;
      }

      try {
        debugLog('Creating ECDSA validator...');
        const ecdsaValidator = await signerToEcdsaValidator(publicClient, {
          signer: privyAccount,
          entryPoint,
          kernelVersion,
        });

        debugLog('Requesting authorization', {
          contractAddress: kernelAddresses.accountImplementationAddress,
          chainId,
          signerAddress: privyAccount.account.address
        });

        const authorization = await signAuthorization({
          contractAddress: kernelAddresses.accountImplementationAddress,
          chainId,
        });

        debugLog('Authorization received, creating kernel account...');

        const kernelAccount = await create7702KernelAccount(publicClient, {
          signer: privyAccount,
          entryPoint,
          kernelVersion,
          eip7702Auth: authorization,
        });

        debugLog('Creating kernel account client WITH paymaster...');
        const kernelAccountClient = create7702KernelAccountClient({
          account: kernelAccount,
          chain,
          bundlerTransport: http(bundlerRpc),
          paymaster: paymasterClient, // RESTORED
          client: publicClient,
          userOperation: {
            estimateFeesPerGas: async ({ bundlerClient }) => {
              return getUserOperationGasPrice(bundlerClient);
            },
          },
        });

        debugLog('✅ Kernel clients created successfully with paymaster', {
          accountAddress: kernelAccount.address
        });

        return { kernelAccountClient, kernelAccount, ecdsaValidator };
      } catch (error) {
        console.error('❌ Kernel client creation failed:', error);
        console.error('Error details:', {
          name: error.name,
          message: error.message,
          stack: error.stack
        });
        
        // Don't throw the error, let the query handle it gracefully
        return null;
      }
    },
    enabled: !!publicClient && !!privyAccount && !!paymasterClient,
    retry: 1,
    retryDelay: 1000,
  });

  // Log kernel errors but don't break the app
  useEffect(() => {
    if (kernelError) {
      console.error('🔥 Kernel client error (app will continue with limited functionality):', kernelError);
      
      if (kernelError.message?.includes('Invalid SIWE message')) {
        console.log('💡 SIWE error detected. The chain configuration in Privy might be the issue.');
        console.log('💡 Check that Privy is configured for the correct chain (Base: 8453).');
      }
    }
  }, [kernelError]);

  /**
   * Handles the sign-in process by opening the Privy sign-in modal
   */
  const signIn = async () => {
    debugLog('Sign in requested');
    login();
  };

  /**
   * Mutation hook for creating a new embedded wallet
   */
  const { mutate: createEmbeddedWallet } = useMutation({
    mutationFn: async () => {
      debugLog('Creating embedded wallet...');
      const newEmbeddedWallet = await createWallet();
      debugLog('Embedded wallet created', { address: newEmbeddedWallet?.address });
      return newEmbeddedWallet;
    },
    onError: (error) => {
      console.error('❌ Failed to create embedded wallet:', error);
    }
  });

  useEffect(() => {
    if (user) {
      if (!privyEmbeddedWallet) {
        debugLog('User exists but no embedded wallet, creating one...');
        createEmbeddedWallet();
      }
    }
  }, [user, privyEmbeddedWallet, createEmbeddedWallet]);

  const { data: embeddedWallet } = useQuery<EmbeddedWallet | null>({
    queryKey: [
      PROVIDER,
      "embeddedWallet",
      privyEmbeddedWallet?.address,
      user,
      chainId,
    ],
    queryFn: async () => {
      if (!user) return null;
      if (!privyEmbeddedWallet) return null;

      const wallet = {
        provider: "privy" as const,
        address: privyEmbeddedWallet.address as `0x${string}`,
        user: user.email?.address ?? user.id,
      };

      debugLog('Embedded wallet created', wallet);
      return wallet;
    },
    enabled: !!privyEmbeddedWallet && !!user,
  });

  const { data: isDeployed } = useQuery({
    queryKey: [
      PROVIDER,
      "isDeployed",
      kernelClients?.kernelAccount.address,
      chainId,
    ],
    queryFn: async () => {
      if (!kernelClients) return false;
      const deployed = await kernelClients.kernelAccount.isDeployed();
      debugLog('Checked deployment status', { 
        accountAddress: kernelClients.kernelAccount.address,
        isDeployed: deployed 
      });
      return deployed;
    },
    enabled: !!kernelClients?.kernelAccount,
    refetchInterval: ({ state }) => (state.data ? false : 2000),
  });

  // Log final provider state
  useEffect(() => {
    debugLog('Provider state update', {
      hasEmbeddedWallet: !!embeddedWallet,
      isDeployed: Boolean(isDeployed),
      hasKernelClient: !!kernelClients?.kernelAccountClient,
      hasError: !!kernelError
    });
  }, [embeddedWallet, isDeployed, kernelClients?.kernelAccountClient, kernelError]);

  return (
    <AccountProviderContext.Provider
      value={{
        provider: "privy",
        login: signIn,
        embeddedWallet,
        isDeployed: Boolean(isDeployed),
        kernelAccountClient: kernelClients?.kernelAccountClient,
        ecdsaValidator: kernelClients?.ecdsaValidator,
      }}
    >
      {children}
    </AccountProviderContext.Provider>
  );
};

export default PrivyAccountProvider;
